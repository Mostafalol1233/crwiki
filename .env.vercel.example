# Vercel Environment Variables
# Copy these to your Vercel project settings and fill in actual values

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-jwt-secret-key-change-this-in-production
ADMIN_PASSWORD=SuperAdmin#2024$SecurePass!9x

# API Base URL (for frontend)
VITE_API_URL=https://your-vercel-app.vercel.app/api
PUBLIC_BASE_URL=https://your-vercel-app.vercel.app

# Optional: Seeding
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=SuperAdmin#2024$SecurePass!9x

# Optional: Scraper/Service credentials
# Add any external API keys or credentials here

# GitHub Database (optional if using GitHub-as-DB)
GITHUB_TOKEN=ghp_xxxxx
GITHUB_OWNER=YourGitHubUsername
GITHUB_REPO=your-db-repo
GITHUB_BASE_PATH=data

# Optional website publisher ads. Configure one product only after Google approval.
# AdSense:
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-REPLACE_WITH_APPROVED_PUBLISHER_ID
VITE_GOOGLE_ADSENSE_SLOT_WEAPONS=REPLACE_WITH_AD_UNIT_ID

# Or Google Ad Manager:
VITE_GOOGLE_AD_MANAGER_NETWORK_CODE=REPLACE_WITH_NETWORK_CODE
VITE_GOOGLE_AD_MANAGER_UNIT_WEAPONS=REPLACE_WITH_AD_UNIT_PATH
