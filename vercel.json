{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/ai/chat.ts":             { "maxDuration": 60 },
    "api/admin/rebuild.ts":       { "maxDuration": 60 },
    "api/admin/login.ts":         { "maxDuration": 30 },
    "api/auth/register.ts":       { "maxDuration": 30 },
    "api/scrape/[action].ts":    { "maxDuration": 60 },
    "api/player/lookup.ts":       { "maxDuration": 45 },
    "api/prerender.ts":           { "maxDuration": 30 },
    "api/send-email.ts":          { "maxDuration": 20 },
    "api/sitemap.ts":             { "maxDuration": 20 },
    "api/admin/scraper.ts":       { "maxDuration": 60 }
  },

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/highlights/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],

  "crons": [
    { "path": "/api/scrape/automation", "schedule": "0 4 * * *" }
  ],

  "rewrites": [
    { "source": "/api/content", "destination": "/api/sitemap" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },

    { "source": "/events", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fevents" },
    { "source": "/news", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fnews" },
    { "source": "/posts", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fposts" },
    { "source": "/pages", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fpages" },
    { "source": "/tutorials", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Ftutorials" },
    { "source": "/videos", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fvideos" },
    { "source": "/:section(events|news|posts|pages|tutorials|videos|weapons|modes|maps|ranks|mercenaries|content-hub|faq)", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=/:section" },
    { "source": "/ar/:section(events|news|posts|pages|tutorials|videos|weapons|modes|maps|ranks|mercenaries|content-hub|faq)", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Far%2F:section" },
    { "source": "/events/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fevents%2F:slug" },
    { "source": "/ar/events/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Far%2Fevents%2F:slug" },
    { "source": "/news/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fnews%2F:slug" },
    { "source": "/ar/news/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Far%2Fnews%2F:slug" },
    { "source": "/posts/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fposts%2F:slug" },
    { "source": "/ar/posts/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Far%2Fposts%2F:slug" },
    { "source": "/pages/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fpages%2F:slug" },
    { "source": "/ar/pages/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Far%2Fpages%2F:slug" },
    { "source": "/tutorials/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Ftutorials%2F:slug" },
    { "source": "/ar/tutorials/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Far%2Ftutorials%2F:slug" },
    { "source": "/videos/:category/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Fvideos%2F:category%2F:slug" },
    { "source": "/ar/videos/:category/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }], "destination": "/api/prerender?path=%2Far%2Fvideos%2F:category%2F:slug" },
    {
      "source": "/ar/competition",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }],
      "destination": "/api/prerender?path=%2Far%2Fcompetition"
    },
    {
      "source": "/competition",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]).*" }],
      "destination": "/api/prerender?path=%2Fcompetition"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
