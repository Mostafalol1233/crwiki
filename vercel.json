{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "http://51.75.118.151:20032/api/$1" },
    { "src": "/ws", "dest": "http://51.75.118.151:20032/ws" },
    { "src": "/favicon.png", "dest": "https://images.seeklogo.com/logo-png/42/1/crossfire-logo-png_seeklogo-429200.png" },
    { "src": "/favicon.ico", "dest": "https://images.seeklogo.com/logo-png/42/1/crossfire-logo-png_seeklogo-429200.png" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
