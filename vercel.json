{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/client"
      }
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://fi4.bot-hosting.net:20126/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "http://fi4.bot-hosting.net:20126/media/$1"
    },
    {
      "source": "/image/(.*)",
      "destination": "http://fi4.bot-hosting.net:20126/image/$1"
    },
    {
      "source": "/ws",
      "destination": "http://fi4.bot-hosting.net:20126/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
