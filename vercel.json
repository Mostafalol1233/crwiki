{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/client"
      }
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://51.75.118.151:20032/api/$1"
    },
    {
      "source": "/ws",
      "destination": "http://51.75.118.151:20032/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}