{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "${VITE_API_URL}/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "${VITE_API_URL}/assets/$1"
    },
    {
      "source": "/ws",
      "destination": "${VITE_API_URL}/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
