{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "http://51.75.118.151:20032/api/$1" },
    { "source": "/ws", "destination": "http://51.75.118.151:20032/ws" },
    { "source": "/favicon.png", "destination": "https://images.seeklogo.com/logo-png/42/1/crossfire-logo-png_seeklogo-429200.png" },
    { "source": "/favicon.ico", "destination": "https://images.seeklogo.com/logo-png/42/1/crossfire-logo-png_seeklogo-429200.png" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/news/(.*)", "destination": "/index.html" },
    { "source": "/events/(.*)", "destination": "/index.html" },
    { "source": "/weapons", "destination": "/index.html" },
    { "source": "/modes", "destination": "/index.html" },
    { "source": "/ranks", "destination": "/index.html" },
    { "source": "/posts/(.*)", "destination": "/index.html" },
    { "source": "/sellers/(.*)", "destination": "/index.html" },
    { "source": "/tutorials/(.*)", "destination": "/index.html" },
    { "source": "/category/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
